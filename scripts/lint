#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

if [ "$1" = "--fix" ]; then
  echo "==> Running ruff with --fix"
  uv run --locked ruff check . --fix
else
  echo "==> Running ruff"
  uv run --locked ruff check .
fi

echo "==> Running ty"
uv run --locked ty check --exit-zero-on-warning

echo "==> Making sure it imports"
uv run --locked python -c 'import gumnut'
